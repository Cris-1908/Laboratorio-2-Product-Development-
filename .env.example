# Copie este archivo a .env y cambie las claves antes de levantar el producto.
# Use solo letras y números en las claves (van dentro de URLs de conexión).

# Base de datos del producto (también guarda los metadatos de MLflow)
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=cambie_esta_clave
POSTGRES_DB=novamercado
MLFLOW_DB_NAME=mlflow

# Base de datos propia de Airflow (separada de la del producto)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambie_esta_otra_clave

# Usuario de Airflow que usa la API para disparar el reentrenamiento
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambie_esta_tercera_clave
AIRFLOW_SECRET_KEY=cambie_esta_cadena_larga_y_aleatoria

# Ajustes opcionales (estos son los valores por defecto)
# DIAS_VALIDACION=7        # días recientes que se reservan para comparar candidato y vigente
# MEJORA_MINIMA=0.01       # mejora mínima de costo (1 %) para reemplazar al modelo vigente
# INTERVALO_VIGILANCIA=15  # cada cuántos segundos la API revisa MLflow, Airflow y el alias
